{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostnet.styrene.io/schema/incident-transition-v1",
  "title": "GhostNet Incident Transition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "incident_id",
    "state",
    "occurred_at_ms",
    "issuer",
    "reason",
    "extensions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "previous_transition_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "planned",
        "active",
        "monitoring",
        "closed",
        "cancelled"
      ]
    },
    "occurred_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reason": {
      "type": "string",
      "maxLength": 4096
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    }
  }
}
