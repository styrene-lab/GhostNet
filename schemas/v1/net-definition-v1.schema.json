{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostnet.styrene.io/schema/net-definition-v1",
  "title": "GhostNet Net Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "name",
    "description",
    "effective_at_ms",
    "issuer",
    "roles",
    "windows",
    "extensions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_revision_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "effective_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "roles": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object"
      }
    },
    "windows": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    }
  }
}
