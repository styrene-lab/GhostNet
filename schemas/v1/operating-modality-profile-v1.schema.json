{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostnet.styrene.io/schema/operating-modality-profile-v1",
  "title": "GhostNet Operating Modality Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "family", "profile", "version", "display_name", "valid_from_ms", "compatibility", "capabilities", "roles", "artifacts", "policy", "commands", "views", "extensions"],
  "properties": {
    "schema": {"const": "https://ghostnet.styrene.io/schema/operating-modality-profile-v1"},
    "family": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 128},
    "profile": {"type": "string", "pattern": "^[A-Z0-9]+(?:_[A-Z0-9]+)*$", "maxLength": 128},
    "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "valid_from_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "valid_until_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["styrene_om_contract", "cedar_contract", "doctrine_contract"],
      "properties": {
        "styrene_om_contract": {"type": "integer", "minimum": 1},
        "cedar_contract": {"type": "integer", "minimum": 1},
        "doctrine_contract": {"type": "integer", "minimum": 1}
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}},
        "optional": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}}
      }
    },
    "roles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}},
    "artifacts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/resource"}},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "schema", "policies", "scenarios"],
      "properties": {
        "engine": {"const": "cedar"},
        "schema": {"$ref": "#/$defs/resource"},
        "policies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/resource"}},
        "scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/resource"}}
      }
    },
    "commands": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
    "views": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}}
  },
  "$defs": {
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 512},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
