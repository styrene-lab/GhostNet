{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostnet.styrene.io/schema/operational-report-v1",
  "title": "GhostNet Operational Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "net_id",
    "kind",
    "priority",
    "confidence",
    "created_at_ms",
    "author",
    "summary",
    "details",
    "extensions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "net_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "kind": {
      "enum": [
        "report",
        "alert",
        "request",
        "offer",
        "bulletin",
        "checkin"
      ]
    },
    "priority": {
      "enum": [
        "routine",
        "priority",
        "immediate",
        "flash"
      ]
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "details": {
      "type": "string",
      "maxLength": 16384
    },
    "corrects": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "retracts": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    }
  }
}
