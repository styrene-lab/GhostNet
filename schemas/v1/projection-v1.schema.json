{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostnet.styrene.io/schema/projection-v1",
  "title": "GhostNet Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_artifact_id",
    "source_body_hash",
    "projection_schema",
    "projector",
    "created_at_ms",
    "body",
    "omitted_fields",
    "extensions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source_artifact_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source_body_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "projection_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "projector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "body": {
      "type": "string",
      "maxLength": 65536
    },
    "omitted_fields": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    }
  }
}
